# HF Downloader — example configuration (DON'T COMMIT YOUR REAL .env)
# Copy this file to .env and fill in your values if needed.
# This file is safe to keep in the repo — it only contains placeholders.

# Optional: default Hugging Face token.
# NOTE: the current version does NOT read .env — enter the token in the app UI
# (it is kept in the webview's localStorage). This file is only a placeholder for
# a future "default token" feature. DO NOT put a real token here.
HUGGINGFACE_TOKEN=

# Optional: GitHub repository for update checks.
# By default the app knows where to check. Change this only if you forked the project.
HF_DOWNLOADER_UPDATE_REPO=alexveliyar-coder/HF-Downloader
